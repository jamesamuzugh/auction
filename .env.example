# Copy to .env.local and fill in.

# Currency every auction is priced in (ISO code). Paystack supports NGN, GHS, ZAR, KES, USD and others.
# Baked into the pages at build time: set it before `npm run build`.
NEXT_PUBLIC_CURRENCY=GHS

# Public address of the site, used for payment return links. Leave empty in development.
APP_URL=

# Paystack secret key from https://dashboard.paystack.com/#/settings/developers
# Use the sk_test_ key while testing. Set the webhook URL there to <APP_URL>/api/payments/paystack/webhook
# For automatic payouts to sellers, turn OFF "Confirm transfers before sending" (transfer OTP) in Paystack settings.
PAYSTACK_SECRET_KEY=

# Escrow rules
DISPUTE_WINDOW_HOURS=6        # after the delivery partner confirms delivery, how long the buyer can report a problem
PLATFORM_FEE_PERCENT=5        # Bidwell's fee: a percent of the buyer's total, deducted from the seller's payout (and kept on failed deliveries)
# Delivery prices (by item size and distance) are set by an admin on /admin. A return costs the same as the delivery.
# PROOF_DIR=                  # where delivery-attempt photos are kept (defaults to ./data/proofs)

# Comma-separated emails that can open /admin (disputes, escrow, payouts, refunds).
ADMIN_EMAILS=

# Secret for the scheduler that calls /api/cron/escrow every few minutes.
CRON_SECRET=

# Set to 1 to add a pretend checkout and payouts for trying the flow without keys. Never in production.
PAYMENTS_DEMO=0

# Where the SQLite database lives (defaults to ./data/auction.db).
# DATABASE_PATH=

# Text messages for phone verification codes: hubtel or arkesel. Leave empty in development to show codes on screen.
SMS_PROVIDER=
SMS_SENDER_ID=Bidwell
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=
# KYC_DIR=                     # where ID photos are kept (defaults to ./data/kyc). Back it up and keep it private.
